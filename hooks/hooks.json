{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/cli.mjs", "index"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/cli.mjs", "index", "2"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/cli.mjs", "index", "3"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/cli.mjs", "full"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/cli.mjs", "full", "2"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:neocortex:neocortex",
            "tool": "hook_context",
            "input": {
              "moment": "prompt",
              "event": "${hook_event_name}",
              "prompt": "${prompt}"
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:neocortex:neocortex",
            "tool": "hook_context",
            "input": {
              "moment": "edit",
              "event": "${hook_event_name}",
              "file": "${tool_input.file_path}",
              "session": "${session_id}",
              "agent": "${agent_id}"
            }
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:neocortex:neocortex",
            "tool": "hook_context",
            "input": {
              "moment": "read",
              "event": "${hook_event_name}",
              "file": "${tool_input.file_path}",
              "session": "${session_id}",
              "agent": "${agent_id}"
            }
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:neocortex:neocortex",
            "tool": "hook_context",
            "input": {
              "moment": "search",
              "event": "${hook_event_name}",
              "path": "${tool_input.path}",
              "glob": "${tool_input.glob}",
              "type": "${tool_input.type}",
              "session": "${session_id}",
              "agent": "${agent_id}"
            }
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:neocortex:neocortex",
            "tool": "hook_context",
            "input": {
              "moment": "search",
              "event": "${hook_event_name}",
              "path": "${tool_input.path}",
              "pattern": "${tool_input.pattern}",
              "session": "${session_id}",
              "agent": "${agent_id}"
            }
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:neocortex:neocortex",
            "tool": "hook_context",
            "input": {
              "moment": "index",
              "part": 1,
              "event": "${hook_event_name}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "plugin:neocortex:neocortex",
            "tool": "hook_context",
            "input": {
              "moment": "full",
              "event": "${hook_event_name}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "plugin:neocortex:neocortex",
            "tool": "hook_context",
            "input": {
              "moment": "full",
              "part": 2,
              "event": "${hook_event_name}"
            }
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:neocortex:neocortex",
            "tool": "hook_context",
            "input": {
              "moment": "subagent",
              "event": "${hook_event_name}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "plugin:neocortex:neocortex",
            "tool": "hook_context",
            "input": {
              "moment": "prompt",
              "event": "${hook_event_name}"
            }
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(?!mcp__plugin_neocortex_neocortex__.*$)(?!mcp__neocortex__.*$)(?!Read$)(?!Write$)(?!Edit$)(?!MultiEdit$)(?!NotebookEdit$).*$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:neocortex:neocortex",
            "tool": "hook_context",
            "input": {
              "moment": "failure",
              "event": "${hook_event_name}",
              "tool": "${tool_name}",
              "input": "${tool_input}",
              "interrupted": "${is_interrupt}",
              "session": "${session_id}",
              "agent": "${agent_id}"
            }
          }
        ]
      },
      {
        "matcher": "^((Read)|(Write)|(Edit)|(MultiEdit)|(NotebookEdit))$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:neocortex:neocortex",
            "tool": "hook_context",
            "input": {
              "moment": "failure",
              "event": "${hook_event_name}",
              "tool": "${tool_name}",
              "call": "${tool_input.file_path}",
              "notebook": "${tool_input.notebook_path}",
              "interrupted": "${is_interrupt}",
              "session": "${session_id}",
              "agent": "${agent_id}"
            }
          }
        ]
      }
    ]
  }
}
